---
// Ornamentos finos (inspirados na referência): sol, luas e brilho.
interface Props { tipo?: 'sol' | 'luas' | 'brilho'; classe?: string }
const { tipo = 'sol', classe = '' } = Astro.props;
const raios = Array.from({ length: 13 }, (_, i) => {
  const a = Math.PI * (i / 12);
  const r2 = i % 2 ? 40 : 46;
  return `M${(60 - Math.cos(a) * 34).toFixed(1)} ${(44 - Math.sin(a) * 34).toFixed(1)}L${(60 - Math.cos(a) * r2).toFixed(1)} ${(44 - Math.sin(a) * r2).toFixed(1)}`;
});
---
{tipo === 'sol' && (
  <svg class:list={['ornamento', classe]} viewBox="0 0 120 50" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round">
    <path d="M30 44a30 30 0 0 1 60 0" /><path d="M42 44a18 18 0 0 1 36 0" />
    {raios.map((d) => <path d={d} />)}
    <path d="M8 44h104" /><circle cx="60" cy="44" r="3" fill="currentColor" />
  </svg>
)}
{tipo === 'luas' && (
  <svg class:list={['ornamento', classe]} viewBox="0 0 170 24" aria-hidden="true">
    <defs>
      <mask id="lua-a"><rect width="170" height="24" fill="#fff" /><circle cx="19" cy="12" r="9" fill="#000" /><circle cx="157" cy="12" r="9" fill="#000" /></mask>
    </defs>
    <g fill="currentColor" opacity=".6">
      <g mask="url(#lua-a)"><circle cx="13" cy="12" r="9" /><circle cx="151" cy="12" r="9" /></g>
      <path d="M50 3a9 9 0 0 0 0 18z" />
      <circle cx="85" cy="12" r="9" />
      <path d="M120 3a9 9 0 0 1 0 18z" />
    </g>
    <g fill="none" stroke="currentColor" stroke-width=".8" opacity=".6"><circle cx="50" cy="12" r="9" /><circle cx="120" cy="12" r="9" /></g>
  </svg>
)}
{tipo === 'brilho' && (
  <svg class:list={['ornamento', classe]} viewBox="0 0 40 40" aria-hidden="true"><path d="M20 0C21 13 27 19 40 20 27 21 21 27 20 40 19 27 13 21 0 20 13 19 19 13 20 0z" fill="currentColor" /></svg>
)}
