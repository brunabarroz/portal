---
// Link de volta para a página anterior (ex.: ← Minhas compras).
interface Props { itens: { nome: string; href?: string }[] }
const { itens } = Astro.props;
const voltar = [...itens].reverse().find((it, i) => i > 0 && it.href);
---
{voltar && <nav class="trilha" aria-label="Voltar"><a href={voltar.href}>{voltar.nome}</a></nav>}
