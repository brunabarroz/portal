---
// Produto como uma polaroid presa com clipe (mesmo estilo de papelaria das pastas).
// O cartão inteiro abre o link de compra.
import Selo from './Selo.astro';
import Clipe from './Clipe.astro';
import { pendente } from '../lib/util';
interface Props { nome: string; link?: string; imagem?: string; descricao?: string; exemplo?: boolean; indice?: number }
const { nome, link, imagem, descricao, exemplo, indice = 0 } = Astro.props;
const temLink = !pendente(link);
const giros = ['-1.6deg', '1.2deg', '-0.6deg', '1.8deg'];
---
<article class="polaroid-produto" style={`--giro:${giros[indice % giros.length]}`}>
  <Clipe estilo={indice % 2 ? 'left:26px;top:-16px' : 'right:26px;top:-16px'} />
  <div class="polaroid-produto__foto">
    {imagem && <img src={imagem} alt="" loading="lazy" />}
  </div>
  <div class="polaroid-produto__legenda">
    {exemplo && <Selo />}
    <h3>
      {temLink
        ? <a class="polaroid-produto__link" href={link} target="_blank" rel="noopener sponsored">{nome}</a>
        : nome}
    </h3>
    {descricao && <p>{descricao}</p>}
    <span class="polaroid-produto__acao">{temLink ? 'ver produto ↗' : 'link em breve'}</span>
  </div>
</article>

<style>
  .polaroid-produto {
    position: relative; background: var(--branco); padding: 10px 10px 12px;
    box-shadow: var(--sombra); transform: rotate(var(--giro));
    transition: transform .25s ease, box-shadow .25s ease;
  }
  .polaroid-produto:has(.polaroid-produto__link:hover),
  .polaroid-produto:has(.polaroid-produto__link:focus-visible) { transform: rotate(0deg) translateY(-4px); box-shadow: 0 14px 30px -14px rgba(47,43,46,.4); }
  .polaroid-produto__foto {
    position: relative; aspect-ratio: 1; overflow: hidden;
    background: var(--area-suave); background-image: var(--grade-papel);
  }
  .polaroid-produto__foto img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; background: #fff; }
  .polaroid-produto__legenda { padding: 12px 4px 0; text-align: center; display: grid; gap: 2px; justify-items: center; }
  .polaroid-produto h3 { font-size: 1.15rem; line-height: 1.15; margin: 0; }
  .polaroid-produto__link { color: var(--noite); text-decoration: none; }
  .polaroid-produto__link::after { content: ''; position: absolute; inset: 0; z-index: 5; }
  .polaroid-produto p { margin: 0; font-size: .92rem; color: var(--texto-suave); }
  .polaroid-produto__acao { margin-top: 4px; font-family: var(--f-mono); font-size: .66rem; letter-spacing: .12em; text-transform: uppercase; color: var(--area-forte); }
  @media (prefers-reduced-motion: reduce) { .polaroid-produto { transform: none; } }
</style>
