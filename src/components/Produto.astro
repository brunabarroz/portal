---
// Cartão de produto: foto, nome e botão. O cartão inteiro abre o link de compra.
import Selo from './Selo.astro';
import { pendente } from '../lib/util';
interface Props { nome: string; link?: string; imagem?: string; descricao?: string; exemplo?: boolean }
const { nome, link, imagem, descricao, exemplo } = Astro.props;
const temLink = !pendente(link);
---
<article class="produto">
  <div class="produto__foto">{imagem && <img src={imagem} alt="" loading="lazy" />}</div>
  <div class="produto__info">
    {exemplo && <Selo />}
    <h3>
      {temLink
        ? <a class="produto__link" href={link} target="_blank" rel="noopener sponsored">{nome}</a>
        : nome}
    </h3>
    {descricao && <p>{descricao}</p>}
    <span class="produto__botao">{temLink ? 'Ver produto' : 'Link em breve'}</span>
  </div>
</article>

<style>
  .produto {
    position: relative; display: flex; flex-direction: column;
    background: var(--branco); border: 1px solid var(--linha); border-radius: var(--raio); overflow: hidden;
    transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
  }
  .produto:has(.produto__link:hover), .produto:has(.produto__link:focus-visible) { transform: translateY(-3px); box-shadow: var(--sombra); border-color: var(--area); }
  .produto__foto { position: relative; aspect-ratio: 1; background: var(--area-suave); }
  .produto__foto img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; background: #fff; }
  .produto__info { padding: 12px 14px 14px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
  .produto h3 { font-family: var(--f-texto); font-size: .98rem; font-weight: 600; line-height: 1.3; margin: 0; }
  .produto__link { color: var(--tinta); text-decoration: none; }
  .produto__link::after { content: ''; position: absolute; inset: 0; }
  .produto p { margin: 0; font-size: .88rem; color: var(--suave); line-height: 1.4; }
  .produto__botao {
    margin-top: auto; align-self: flex-start; padding: 6px 14px; border-radius: 999px;
    background: var(--area-suave); color: var(--area-forte); font-size: .82rem; font-weight: 600;
  }
  .produto:has(.produto__link:hover) .produto__botao { background: var(--area); color: var(--tinta); }
</style>
