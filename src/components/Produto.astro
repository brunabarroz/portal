---
// Cartão de produto: foto quadrada + nome. O cartão inteiro abre o link de compra.
import Selo from './Selo.astro';
import { pendente } from '../lib/util';
interface Props { nome: string; link?: string; imagem?: string; descricao?: string; exemplo?: boolean }
const { nome, link, imagem, descricao, exemplo } = Astro.props;
const temLink = !pendente(link);
---
<article class="produto">
  <div class="produto__foto">{imagem ? <img src={imagem} alt="" loading="lazy" /> : <span class="produto__inicial" aria-hidden="true">{nome.charAt(0)}</span>}</div>
  <div class="produto__info">
    {exemplo && <Selo />}
    <h3>
      {temLink
        ? <a class="produto__link" href={link} target="_blank" rel="noopener sponsored">{nome}</a>
        : nome}
    </h3>
    {descricao && <p>{descricao}</p>}
    <span class="produto__acao">{temLink ? 'ver produto ↗' : 'link em breve'}</span>
  </div>
</article>

<style>
  .produto {
    position: relative; display: flex; flex-direction: column;
    background: var(--branco); border: 1px solid var(--linha); border-radius: 6px; overflow: hidden;
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .produto:has(.produto__link:hover), .produto:has(.produto__link:focus-visible) { transform: translateY(-3px); box-shadow: var(--sombra); }
  .produto__foto { position: relative; aspect-ratio: 1; overflow: hidden; background: #fff; border-bottom: 1px solid var(--linha); }
  .produto__foto img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .produto__foto:has(.produto__inicial) { display: grid; place-items: center; background: linear-gradient(165deg, var(--area-suave), var(--creme)); }
  .produto__inicial { font-family: var(--f-script); font-size: 4.5rem; line-height: 1; color: var(--area-forte); opacity: .7; }
  .produto__info { padding: 14px 16px 16px; display: grid; gap: 4px; flex: 1; align-content: start; }
  .produto h3 { font-size: 1.3rem; margin: 0; }
  .produto__link { color: var(--noite); text-decoration: none; }
  .produto__link::after { content: ''; position: absolute; inset: 0; }
  .produto p { margin: 0; font-size: .95rem; color: var(--texto-suave); }
  .produto__acao { margin-top: 6px; font-family: var(--f-mono); font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--area-forte); }
</style>
