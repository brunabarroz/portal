---
// Ícones simples das redes sociais.
interface Props { rede: string }
const r = Astro.props.rede.toLowerCase();
---
{r === 'youtube' && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="4" fill="currentColor"/><path d="M10 9l5 3-5 3z" fill="var(--papel)"/></svg>}
{r === 'tiktok' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3h3c.3 2 1.6 3.6 4 4v3c-1.6 0-3-.5-4-1.2V15a6 6 0 1 1-6-6v3.2A2.8 2.8 0 1 0 14 15z" fill="currentColor"/></svg>}
{r === 'instagram' && <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>}
{r === 'linkedin' && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="3" fill="currentColor"/><path d="M7 10v7M7 7v.01M11 17v-7m0 3.5c0-2 1.2-3.5 3-3.5s2.5 1.3 2.5 3V17" stroke="var(--papel)" stroke-width="2" stroke-linecap="round" fill="none"/></svg>}
