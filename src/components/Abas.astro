---
// Navegação principal: pastas de arquivo na lateral (computador)
// e abas de pasta no topo (celular).
import { AREAS, ORDEM_AREAS, type AreaId } from '../lib/estrutura';
interface Props { area: AreaId; naEntrada: boolean }
const { area, naEntrada } = Astro.props;
const atual = (id: AreaId) => (id === area ? (naEntrada ? 'page' : 'location') : undefined);
---
<aside class="lateral">
  <a class="marca" href="/" aria-label="Bruna Barros — página inicial">
    <span class="marca__nome">Bruna Barros</span>
  </a>
  <nav aria-label="Áreas do site">
    <ul class="pastas">
      {ORDEM_AREAS.map((id) => (
        <li>
          <a class:list={['pasta-l', `pasta-l--${id}`, id === 'curso' && 'pasta-l--direita']} href={AREAS[id].href} aria-current={atual(id)}>
            <span class="pasta-l__aba">{AREAS[id].numero} · {AREAS[id].curto}</span>
            <span class="pasta-l__corpo"><span class="pasta-l__nome">{AREAS[id].nome}</span></span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <p class="lateral__rodape">© {new Date().getFullYear()} Bruna Barros</p>
</aside>

<header class="topo-mobile">
  <a class="marca" href="/"><span class="marca__nome">Bruna Barros</span></a>
  <nav aria-label="Áreas do site">
    <ul class="abas-mobile">
      {ORDEM_AREAS.map((id) => (
        <li><a class={`cor-${id}`} href={AREAS[id].href} aria-current={atual(id)}>{AREAS[id].curto}</a></li>
      ))}
    </ul>
  </nav>
</header>
