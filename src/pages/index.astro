---
// PASTA 01 · BRUNA BARROS (página inicial)
// No celular funciona como "link na bio": foto, nome e botões grandes logo no topo.
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import { AREAS } from '../lib/estrutura';
import { pendente } from '../lib/util';
import { perfil } from '../lib/dados';

const redes = perfil.redes.filter((r) => !pendente(r.url));
const atalhos = [
  { area: 'curso', titulo: AREAS.curso.nome, sub: 'Meu curso para trabalhar para fora', href: AREAS.curso.href },
  { area: 'compras', titulo: AREAS.compras.nome, sub: 'O que eu uso e indico', href: AREAS.compras.href },
];
---
<Base area="bruna" titulo="Bruna Barros" descricao={perfil.linhaApoio}>
  <section class="inicio">
    {!pendente(perfil.foto) && (
      <figure class="inicio__foto"><img src={perfil.foto} alt={perfil.fotoDescricao} width="480" height="600" /></figure>
    )}

    <header class="inicio__topo">
      <p class="inicio__oi">{perfil.saudacao.replace(/\.$/, '')}</p>
      <h1>{perfil.nome}</h1>
      {perfil.linhaApoio && <p class="inicio__apoio">{perfil.linhaApoio}</p>}
    </header>

    <nav class="inicio__links" aria-label="Por onde começar">
      {atalhos.map((a) => (
        <a class={`atalho atalho--${a.area}`} href={a.href}>
          <span class="atalho__pasta" aria-hidden="true"></span>
          <span class="atalho__texto"><strong>{a.titulo}</strong><small>{a.sub}</small></span>
          <span class="atalho__seta" aria-hidden="true">→</span>
        </a>
      ))}
    </nav>

    {redes.length > 0 && (
      <ul class="inicio__redes" aria-label="Redes sociais">
        {redes.map((r) => (
          <li><a href={r.url} target="_blank" rel="noopener"><Icone rede={r.rede} /><span>{r.rede}</span></a></li>
        ))}
      </ul>
    )}

    {!pendente(perfil.bio) && (
      <div class="inicio__bio">
        <h2>Sobre mim</h2>
        <p>{perfil.bio}</p>
      </div>
    )}
  </section>
</Base>

<style>
  .inicio {
    display: grid; gap: 0 56px; align-items: start;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 340px);
    grid-template-areas: 'topo foto' 'links foto' 'redes foto' 'bio foto';
  }
  .inicio__foto { grid-area: foto; margin: 0; border-radius: 200px 200px 18px 18px; overflow: hidden; aspect-ratio: 4 / 5; background: var(--lilas-claro); }
  .inicio__foto img { width: 100%; height: 100%; object-fit: cover; }
  .inicio__topo { grid-area: topo; }
  .inicio__oi { font-family: var(--f-titulo); font-style: italic; font-size: 1.4rem; color: var(--lilas-forte); margin: 0 0 4px; }
  .inicio__topo h1 { margin: 0 0 6px; }
  .inicio__apoio { color: var(--suave); margin: 0 0 22px; }
  .inicio__bio { grid-area: bio; max-width: 560px; color: var(--suave); margin-top: 28px; font-size: .98rem; }
  .inicio__bio h2 { display: none; }

  .inicio__links { grid-area: links; display: grid; gap: 12px; max-width: 520px; margin: 8px 0 22px; }
  .atalho {
    --cor: var(--lilas); --forte: var(--lilas-forte);
    display: flex; align-items: center; gap: 16px; padding: 14px 18px;
    background: var(--branco); border: 1px solid var(--linha); border-radius: var(--raio);
    color: var(--tinta); text-decoration: none; box-shadow: var(--sombra);
    transition: transform .15s ease, border-color .15s ease;
  }
  .atalho--curso { --cor: var(--azul); --forte: var(--azul-forte); }
  .atalho--compras { --cor: var(--areia); --forte: var(--areia-forte); }
  .atalho:hover { transform: translateY(-2px); border-color: var(--forte); color: var(--tinta); }
  /* mini pasta de arquivo */
  .atalho__pasta { position: relative; flex: none; width: 42px; height: 32px; margin-top: 6px; background: var(--cor); border-radius: 0 5px 5px 5px; }
  .atalho__pasta::before { content: ''; position: absolute; left: 0; top: -6px; width: 18px; height: 7px; background: var(--cor); border-radius: 4px 8px 0 0; }
  .atalho__pasta::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 24px; background: color-mix(in srgb, var(--cor) 60%, #fff); border-radius: 0 0 5px 5px; }
  .atalho__texto { flex: 1; display: grid; }
  .atalho__texto strong { font-size: 1.05rem; font-weight: 600; }
  .atalho__texto small { font-size: .88rem; color: var(--suave); }
  .atalho__seta { color: var(--forte); font-size: 1.2rem; }

  .inicio__redes { grid-area: redes; list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .inicio__redes a {
    display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px;
    border: 1px solid var(--linha); border-radius: 999px; background: var(--branco);
    color: var(--tinta); text-decoration: none; font-size: .9rem; font-weight: 500;
  }
  .inicio__redes a:hover { border-color: var(--lilas-forte); }
  .inicio__redes :global(svg) { width: 17px; height: 17px; }

  @media (max-width: 860px) {
    .inicio {
      grid-template-columns: 1fr; text-align: center;
      grid-template-areas: 'foto' 'topo' 'links' 'redes' 'bio';
    }
    .inicio__foto { width: 116px; height: 116px; aspect-ratio: 1; border-radius: 50%; margin: 6px auto 14px; }
    .inicio__oi { font-size: 1.15rem; }
    .inicio__topo h1 { font-size: 2.2rem; }
    .inicio__apoio { margin-bottom: 18px; font-size: .95rem; }
    .inicio__links { margin: 0 auto 18px; width: 100%; text-align: left; }
    .inicio__redes { justify-content: center; margin-bottom: 32px; }
    .inicio__bio { text-align: left; margin: 0 auto; border-top: 1px solid var(--linha); padding-top: 24px; }
    .inicio__bio h2 { display: block; font-size: 1.5rem; }
  }
</style>
