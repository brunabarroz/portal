---
// PASTA 01 · BRUNA BARROS (página inicial)
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Texto from '../components/Texto.astro';
import Preencher from '../components/Preencher.astro';
import BotaoLink from '../components/BotaoLink.astro';
import Icone from '../components/Icone.astro';
import Ornamento from '../components/Ornamento.astro';
import Clipe from '../components/Clipe.astro';
import { AREAS, subAbas } from '../lib/estrutura';
import { pendente } from '../lib/util';
import perfil from '../data/perfil.json';

const destaque = perfil.redes.filter((r) => r.destaque);
const outrasRedes = perfil.redes.filter((r) => !r.destaque);
const prevCarreira = (await subAbas('carreira')).slice(0, 4);
const destinos = (await getCollection('destinos')).sort((a, b) => a.data.ordem - b.data.ordem).slice(0, 4);
const prevViagens = (await subAbas('viagens')).filter((s) => s.nome !== 'Destinos').slice(0, 4);
---
<Base area="bruna" titulo="Bruna Barros" descricao={perfil.linhaApoio}>
  <section class="mentor">
    <div class="mentor__texto">
      <p class="mentor__script script">{perfil.saudacao.replace(/\.$/, '')}</p>
      <h1 class="mentor__titulo">{perfil.nome}</h1>
      <p class="caps mentor__apoio">{perfil.linhaApoio}</p>
      <p class="mentor__bio"><Texto valor={perfil.bio} /></p>

      <div class="redes">
        {destaque.map((r) => (
          <BotaoLink href={r.url} rotulo={r.rede} falta={`link do ${r.rede}`}><Icone rede={r.rede} /></BotaoLink>
        ))}
      </div>
      {outrasRedes.length > 0 && (
        <ul class="redes-menores">
          {outrasRedes.map((r) => (
            <li>
              {pendente(r.url)
                ? <span class="link-seta">{r.rede} <Preencher texto="link" /></span>
                : <a class="link-seta" href={r.url} target="_blank" rel="noopener">{r.rede}</a>}
            </li>
          ))}
        </ul>
      )}
    </div>

    <div class="mentor__foto">
      <Ornamento tipo="luas" classe="mentor__luas" />
      <figure class="oval">
        {pendente(perfil.foto)
          ? <div class="oval__vazia"><Preencher texto="sua foto" /></div>
          : <img src={perfil.foto} alt={perfil.fotoDescricao} width="420" height="560" />}
      </figure>
      <Ornamento tipo="brilho" classe="mentor__brilho" />
    </div>
  </section>

  <section class="faixa faixa--azul" aria-labelledby="por-onde">
    <div class="titulo-centro">
      <span class="script">escolha uma pasta</span>
      <h2 id="por-onde">Por onde você quer começar?</h2>
    </div>

    <div class="previas">
      <article class="previa pasta--carreira">
        <a class="pasta__aba" href={AREAS.carreira.href}>{AREAS.carreira.numero} · {AREAS.carreira.nome}</a>
        <div class="previa__corpo">
          <Clipe tipo="prendedor" estilo="right:28px;top:-20px" />
          <p class="previa__texto">{AREAS.carreira.convite}</p>
          <ul class="previa__lista">
            {prevCarreira.map((s) => <li><a href={s.href}><span>{s.nome}</span><small>{s.descricao}</small></a></li>)}
          </ul>
          <a class="link-seta" href={AREAS.carreira.href}>abrir carreira internacional</a>
        </div>
      </article>

      <article class="previa previa--direita pasta--viagens">
        <a class="pasta__aba" href={AREAS.viagens.href}>{AREAS.viagens.numero} · {AREAS.viagens.nome}</a>
        <div class="previa__corpo">
          <Clipe estilo="left:30px;top:-16px" />
          <p class="previa__texto">{AREAS.viagens.convite}</p>
          {destinos.length > 0 && (
            <ul class="previa__destinos" aria-label="Destinos">
              {destinos.map((d) => <li><a href={`/viagens/destinos/${d.slug}/`}>{d.data.titulo}</a></li>)}
            </ul>
          )}
          <ul class="previa__lista">
            {prevViagens.map((s) => <li><a href={s.href}><span>{s.nome}</span><small>{s.descricao}</small></a></li>)}
          </ul>
          <a class="link-seta" href={AREAS.viagens.href}>abrir viagens</a>
        </div>
      </article>
    </div>
  </section>
</Base>

<style>
  .mentor { display: grid; grid-template-columns: 1.15fr .85fr; gap: 56px; align-items: center; margin: 26px 0 70px; }
  .mentor__script { font-size: clamp(2.8rem, 5vw, 3.8rem); line-height: 1; color: var(--noite); margin: 0 0 6px; }
  .mentor__titulo { font-size: clamp(1.7rem, 3vw, 2.2rem); font-weight: 400; margin: 0 0 12px; }
  .mentor__apoio { color: var(--texto-suave); margin-bottom: 22px; }
  .mentor__bio { font-size: 1.12rem; max-width: 540px; margin-bottom: 28px; }
  .redes { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 20px; }
  .redes-menores { list-style: none; display: flex; flex-wrap: wrap; gap: 10px 26px; padding: 0; margin: 0; }

  .mentor__foto { position: relative; display: grid; justify-items: center; }
  :global(.mentor__luas) { width: 210px; color: var(--lilas-forte); margin-bottom: 18px; }
  .oval {
    margin: 0; width: min(100%, 330px); aspect-ratio: 3 / 4;
    border-radius: 50%; overflow: hidden; position: relative;
    outline: 1px solid var(--lilas-forte); outline-offset: 10px;
    background: linear-gradient(170deg, var(--azul-claro), var(--lilas-claro) 55%, var(--areia-claro));
  }
  .oval img { width: 100%; height: 100%; object-fit: cover; }
  .oval__vazia { width: 100%; height: 100%; display: grid; place-items: center; padding: 30px; text-align: center; }
  :global(.mentor__brilho) { position: absolute; width: 30px; right: 6%; bottom: 2%; color: var(--azul-forte); }

  .previas { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: 40px 26px; align-items: start; }
  .previa { position: relative; padding-top: 36px; }
  .previa .pasta__aba { color: var(--noite); text-decoration: none; }
  .previa--direita .pasta__aba { left: auto; right: 0; border-radius: 30px 8px 0 0; padding: 9px 18px 0 40px; }
  .previa__corpo {
    position: relative; display: block; isolation: isolate;
    background: var(--frente); border-radius: 0 10px 6px 6px; padding: 30px 26px 26px;
    box-shadow: 0 -10px 0 -2px var(--cor), 0 10px 26px -16px rgba(47,43,46,.4);
  }
  .previa--direita .previa__corpo { border-radius: 10px 0 6px 6px; }
  .previa__texto { font-size: 1.08rem; margin-bottom: 16px; }
  .previa__lista { list-style: none; padding: 0; margin: 0 0 20px; display: grid; gap: 8px; }
  .previa__lista a { display: grid; padding: 10px 14px; background: var(--branco); border-radius: 2px; color: var(--noite); text-decoration: none; border-left: 3px solid var(--cor); transition: transform .2s ease; }
  .previa__lista a:hover { transform: translateX(4px); }
  .previa__lista span { font-family: var(--f-titulo); font-size: 1.3rem; font-weight: 500; line-height: 1.15; }
  .previa__lista small { font-size: .9rem; color: var(--texto-suave); }
  .previa__destinos { list-style: none; padding: 0; margin: 0 0 14px; display: flex; flex-wrap: wrap; gap: 8px; }
  .previa__destinos a { display: inline-block; padding: 4px 14px; border: 1px solid var(--areia-forte); border-radius: 999px; color: var(--noite); text-decoration: none; font-family: var(--f-script); font-size: 1.35rem; line-height: 1.3; background: var(--branco); }
  .previa__destinos a:hover { background: var(--areia); }

  @media (max-width: 860px) {
    .mentor { grid-template-columns: 1fr; gap: 26px; margin-top: 16px; text-align: center; }
    .mentor__foto { order: -1; }
    :global(.mentor__luas) { width: 160px; }
    .oval { width: 210px; }
    .mentor__bio { margin-left: auto; margin-right: auto; }
    .redes, .redes-menores { justify-content: center; }
  }
</style>
