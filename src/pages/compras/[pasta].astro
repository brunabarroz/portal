---
// Uma pasta de compras (ex.: Viagem e mochilão) com os produtos e os links.
import Base from '../../layouts/Base.astro';
import Cabecalho from '../../components/Cabecalho.astro';
import Produto from '../../components/Produto.astro';
import { pastasCompras, type Pasta } from '../../lib/estrutura';

export async function getStaticPaths() {
  const pastas = await pastasCompras();
  return pastas.map((pasta) => ({ params: { pasta: pasta.slug }, props: { pasta } }));
}
const { pasta } = Astro.props as { pasta: Pasta };
---
<Base area="compras" titulo={pasta.nome} trilha={[{ nome: pasta.nome }]} subAtiva={pasta.href}>
  <Cabecalho etiqueta="minhas compras" titulo={pasta.nome} descricao={`${pasta.produtos.length} ${pasta.produtos.length === 1 ? "indicação" : "indicações"}`} />
  <div class="grade grade--3 vitrine">
    {pasta.produtos.map((p) => (
      <Produto nome={p.data.nome} link={p.data.link} imagem={p.data.imagem} descricao={p.data.descricao} exemplo={p.data.exemplo} />
    ))}
  </div>
</Base>

<style>
  .vitrine { grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); gap: 18px; }
  @media (max-width: 860px) { .vitrine { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; } }
</style>
