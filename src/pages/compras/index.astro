---
// PASTA 03 · MINHAS COMPRAS — uma pastinha para cada tipo de indicação.
import Base from '../../layouts/Base.astro';
import Cabecalho from '../../components/Cabecalho.astro';
import { pastasCompras } from '../../lib/estrutura';
const pastas = await pastasCompras();
---
<Base area="compras" titulo="Minhas compras" descricao="Tudo o que eu uso e indico, separado por pasta.">
  <Cabecalho etiqueta="indicações" titulo="Minhas compras" descricao="O que eu uso e indico. Escolha uma pasta." />

  {pastas.length === 0
    ? <p class="vazio">Em breve, as primeiras indicações.</p>
    : (
      <ul class="pastinhas">
        {pastas.map((p, i) => (
          <li>
            <a class="pasta" href={p.href}>
              <span class="pasta__aba">{String(i + 1).padStart(2, '0')} · {p.produtos.length} {p.produtos.length === 1 ? 'item' : 'itens'}</span>
              <span class="pasta__corpo">
                <span class="pasta__texto">
                  <span class="pasta__nome">{p.nome}</span>
                  <span class="pasta__desc">Abrir pasta →</span>
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    )}
</Base>

<style>
  .pastinhas { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 24px 20px; }
  .vazio { color: var(--suave); }
</style>
