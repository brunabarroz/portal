---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cabecalho from '../../components/Cabecalho.astro';
import Video from '../../components/Video.astro';
import { porData } from '../../lib/util';
const videos = (await getCollection('videos')).sort(porData);
const destinos = (await getCollection('destinos')).sort((a, b) => a.data.ordem - b.data.ordem);
const grupos = [
  ...destinos.map((d) => ({ id: d.slug, nome: d.data.titulo, itens: videos.filter((v) => v.data.destino === d.slug) })),
  { id: 'gerais', nome: 'Vídeos gerais', itens: videos.filter((v) => !v.data.destino || !destinos.some((d) => d.slug === v.data.destino)) },
].filter((g) => g.itens.length > 0);
---
<Base area="viagens" titulo="Vídeos" trilha={[{ nome: 'Vídeos' }]}>
  <Cabecalho etiqueta="viagens" titulo="Vídeos" descricao="Meus vídeos do YouTube, organizados por destino." />
  {grupos.length > 1 && <nav class="ancoras" aria-label="Destinos"><ul class="chips">{grupos.map((g) => <li><a class="chip" href={`#${g.id}`}>{g.nome}</a></li>)}</ul></nav>}
  {grupos.map((g) => (
    <section class="secao" id={g.id}>
      <h2>{g.nome}</h2>
      <div class="grade">{g.itens.map((v) => <Video titulo={v.data.titulo} youtube={v.data.youtube} exemplo={v.data.exemplo} />)}</div>
    </section>
  ))}
</Base>
